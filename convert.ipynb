   "source": [
    "import joblib\n",
    "import json\n",
    "\n",
    "# Load your trained PCA\n",
    "pca = joblib.load(\"pca_model.joblib\")\n",
    "\n",
    "pca_data = {\n",
    "    \"mean\": pca.mean_.tolist(),          # 111\n",
    "    \"components\": pca.components_.tolist()  # 9 x 111\n",
    "}\n",
    "\n",
    "with open(\"pca_model.json\", \"w\") as f:\n",
    "    json.dump(pca_data, f)\n"
   ]
  },
